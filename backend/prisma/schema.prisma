generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  adminUser  Boolean  @default(false)
  dcClose    Boolean  @default(false)
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  deletedAt  DateTime?
  deletedBy  Int?
  concernIds Int[]    @default([])
  canAdd     Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  IsMD       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  userTenants UserTenant[]
  
  @@map("users")
}

model Tenant {
  id           Int     @id @default(autoincrement())
  concernId    Int
  financialYear String
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  concern     Concern @relation(fields: [concernId], references: [id])
  userTenants UserTenant[]
  fabricInwards FabricInwardHeader[]
  rateQuotations RateQuotationHeader[]
  fabricDcs FabricDcHeader[]
  fabricReturns FabricReturnHeader[]
  fabricBills FabricBillHeader[]
  settings Settings?
  
  @@unique([concernId, financialYear])
  @@map("tenants")
}

model UserTenant {
  id       Int @id @default(autoincrement())
  userId   Int
  tenantId Int
  
  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
  
  @@unique([userId, tenantId])
  @@map("user_tenants")
}

model Party {
  id            Int      @id @default(autoincrement())
  partyName     String   @db.VarChar(50)
  partyCode     String?  @db.VarChar(50)
  address1      String?  @db.VarChar(50)
  address2      String?  @db.VarChar(50)
  address3      String?  @db.VarChar(50)
  address4      String?  @db.VarChar(50)
  pincode       String?  @db.VarChar(8)
  district      String?  @db.VarChar(50)
  state         String?  @db.VarChar(50)
  mobileNo      String?  @db.VarChar(10)
  phoneNo       String?  @db.VarChar(10)
  email         String?  @db.VarChar(100)
  panNo         String?  @db.VarChar(10)
  tanNo         String?  @db.VarChar(50)
  tallyAccName  String?  @db.VarChar(50)
  gstNo         String?  @db.VarChar(15)
  registered    Int      @default(1)
  againstPayment Int     @default(0)
  creditDays    Int      @default(0)
  isApproval    Int      @default(0)
  creditAmount  Decimal  @default(0) @db.Decimal(12, 2)
  accountNo     String?  @db.VarChar(30)
  bank          String?  @db.VarChar(30)
  ifscCode      String?  @db.VarChar(12)
  branch        String?  @db.VarChar(30)
  active        Int      @default(1)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  contacts   PartyContact[]
  partyTypes PartyPartyType[]
  designs    Design[]
  rateQuotations RateQuotationHeader[]
  fabricBills FabricBillHeader[] @relation("BillParty")
  fabricBillInvoices FabricBillHeader[] @relation("BillInvoiceTo")
  
  @@map("parties")
}

model PartyContact {
  id               Int     @id @default(autoincrement())
  partyId          Int
  name             String? @db.VarChar(50)
  mobileNo         String? @db.VarChar(10)
  email            String? @db.VarChar(100)
  whatsappRequired Int     @default(0)
  mailRequired     Int     @default(0)
  
  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)
  
  @@map("party_contacts")
}

model Concern {
  id            Int      @id @default(autoincrement())
  partyName     String   @db.VarChar(50)
  vendorCode    String?  @db.VarChar(50)
  address1      String?  @db.VarChar(50)
  address2      String?  @db.VarChar(50)
  address3      String?  @db.VarChar(50)
  address4      String?  @db.VarChar(50)
  pincode       String?  @db.VarChar(8)
  district      String?  @db.VarChar(50)
  state         String?  @db.VarChar(50)
  mobileNo      String?  @db.VarChar(10)
  phoneNo       String?  @db.VarChar(10)
  email         String?  @db.VarChar(100)
  panNo         String?  @db.VarChar(10)
  tallyAccName  String?  @db.VarChar(50)
  gstNo         String?  @db.VarChar(15)
  creditDays    Int      @default(0)
  accountNo     String?  @db.VarChar(30)
  bank          String?  @db.VarChar(30)
  ifscCode      String?  @db.VarChar(12)
  branch        String?  @db.VarChar(30)
  active        Int      @default(1)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
 
  contacts ConcernContact[]
  tenants  Tenant[]
  fabricInwards FabricInwardHeader[]
  rateQuotations RateQuotationHeader[]
  fabricDcs FabricDcHeader[]
  fabricReturns FabricReturnHeader[]
  fabricBills FabricBillHeader[]
 
  @@map("concerns")
}

model ConcernContact {
  id               Int     @id @default(autoincrement())
  concernId        Int
  name             String? @db.VarChar(50)
  mobileNo         String? @db.VarChar(10)
  email            String? @db.VarChar(100)
  whatsappRequired Int     @default(0)
  mailRequired     Int     @default(0)
 
  concern Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)
 
  @@map("concern_contacts")
}

model PartyType {
  id            Int      @id @default(autoincrement())
  partyTypeName String   @db.VarChar(50)
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  parties PartyPartyType[]
  
  @@map("party_types")
}

model PartyPartyType {
  id          Int @id @default(autoincrement())
  partyId     Int
  partyTypeId Int
  
  party     Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyType PartyType @relation(fields: [partyTypeId], references: [id], onDelete: Cascade)
  
  @@unique([partyId, partyTypeId])
  @@map("party_party_types")
}

model Process {
  id                 Int      @id @default(autoincrement())
  processName        String   @unique @db.VarChar(100)
  tallyName          String?  @db.VarChar(100)
  category           String   @db.VarChar(50)
  productionExcess   Decimal  @default(0) @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  notRequiredRate    Boolean  @default(false)
  wetCondition       Boolean  @default(false)
  isDeleted          Boolean  @default(false)
  deletedAt          DateTime?
  deletedBy          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  rateQuotationDetails RateQuotationDetail[]
  
  @@map("processes")
}


model Design {
  id                  Int      @id @default(autoincrement())
  refNo               String?  @db.VarChar(50)
  date                DateTime @default(now())
  customerId          Int?
  designNo            String   @db.VarChar(50)
  designName          String   @db.VarChar(100)
  typeOfPrint         String?  @db.VarChar(50)
  noOfColor           Int      @default(1)
  noOfPrint           Int      @default(1)
  commercialRate      Decimal  @default(0) @db.Decimal(10, 2)
  confirmRate         Decimal  @default(0) @db.Decimal(10, 2)
  followupId          Int?
  buyerId             Int?
  designCompleted     Int      @default(0)
  strikeOffApproval   Int      @default(0)
  strikeOffRejected   Int      @default(0)
  strikeOffComment    String?  @db.Text
  description         String?  @db.Text
  remarks             String?  @db.Text
  imagePath           String?  @db.VarChar(255)
  isActive            Boolean  @default(true)
  isApproval          Int      @default(0)
  isDeleted           Boolean  @default(false)
  deletedAt           DateTime?
  deletedBy           Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  customer Party? @relation(fields: [customerId], references: [id])
  fabricInwardDetails FabricInwardDetail[]
  
  @@map("designs")
}

model PartyProcessRateSetting {
  id            Int      @id @default(autoincrement())
  partyId       Int
  processId     Int
  ratePerKg     Decimal  @default(0) @db.Decimal(12, 2)
  ratePerPiece  Decimal  @default(0) @db.Decimal(12, 2)
  minAmount     Decimal  @default(0) @db.Decimal(12, 2)
  minKgsProcess Decimal  @default(0) @db.Decimal(12, 3)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("party_process_rate_settings")
}

model GstMaster {
  id            Int      @id @default(autoincrement())
  taxName       String   @db.VarChar(50)
  taxPercent    Decimal  @db.Decimal(12, 2)
  taxType       String   @db.VarChar(10)
  isActive      Int      @default(1)
  isLoadDefault Int      @default(0)
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("gst_masters")
}

model Master {
  id          Int      @id @default(autoincrement())
  masterType  String   @db.VarChar(50)
  masterName  String   @db.VarChar(100)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  deletedBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  fabricDetails    FabricInwardDetail[] @relation("FabricMaster")
  colorDetails     FabricInwardDetail[] @relation("ColorMaster")
  diaDetails       FabricInwardDetail[] @relation("DiaMaster")
  uomDetails       FabricInwardDetail[] @relation("UOMMaster")
  dcFabricDetails  FabricDcDetail[]     @relation("DcFabricMaster")
  dcColorDetails   FabricDcDetail[]     @relation("DcColorMaster")
  dcDiaDetails     FabricDcDetail[]     @relation("DcDiaMaster")
  dcInwFabricDetails FabricDcDetail[]   @relation("DcInwFabricMaster")
  dcInwColorDetails  FabricDcDetail[]   @relation("DcInwColorMaster")
  dcInwDiaDetails    FabricDcDetail[]   @relation("DcInwDiaMaster")
  dcUomDetails     FabricDcDetail[]     @relation("DcUOMMaster")
  returnFabricDetails FabricReturnDetail[] @relation("ReturnFabricMaster")
  returnColorDetails  FabricReturnDetail[] @relation("ReturnColorMaster")
  returnDiaDetails    FabricReturnDetail[] @relation("ReturnDiaMaster")
  returnUomDetails    FabricReturnDetail[] @relation("ReturnUOMMaster")
  billFabricDetails FabricBillDetail[] @relation("BillFabricMaster")
  billColorDetails  FabricBillDetail[] @relation("BillColorMaster")
  billDiaDetails    FabricBillDetail[] @relation("BillDiaMaster")
  billUomDetails    FabricBillDetail[] @relation("BillUOMMaster")
  billTaxDetails    FabricBillTax[]    @relation("BillTaxMaster")
  
  @@map("masters")
}

model FabricInwardHeader {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  grnNo           String   @db.VarChar(10)
  grnDate         DateTime @default(now())
  partyId         Int?
  pdcNo           String?  @db.VarChar(50)
  pdcDate         DateTime?
  dyeingPartyId   Int?
  dyeingDcNo      String?  @db.VarChar(50)
  dyeingDcDate    DateTime?
  orderNo         String?  @db.VarChar(50)
  poNo            String?  @db.VarChar(50)
  dcType          String   @default("Fresh") @db.VarChar(20)
  fabricType      String   @default("Grey Lot") @db.VarChar(20)
  remarks         String?  @db.VarChar(100)
  vehicleNo       String?  @db.VarChar(20)
  totalQty        Decimal  @default(0) @db.Decimal(12, 3)
  totalRolls      Int      @default(0)
  createdBy       String?  @db.VarChar(50)
  createdDate     DateTime @default(now())
  modifiedBy      String?  @db.VarChar(50)
  modifiedDate    DateTime @updatedAt
  deletedBy       String?  @db.VarChar(50)
  deletedDate     DateTime?
  deleteFlg       Int      @default(0)
  yearId          Int?
  concernId       Int?
  sortOrder       Int?
  isClosed        Int      @default(0)
  
  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  concern   Concern?               @relation(fields: [concernId], references: [id])
  details   FabricInwardDetail[]
  processes FabricInwardProcess[]
  
  @@map("fabric_inward_headers")
}

model FabricInwardDetail {
  id                    Int      @id @default(autoincrement())
  headerId              Int
  fabricId              Int?
  colorId               Int?
  diaId                 Int?
  gsm                   String?  @db.VarChar(100)
  designId              Int?
  designNo              String?  @db.VarChar(100)
  designName            String?  @db.VarChar(100)
  noOfColor             Int?
  productionNotRequired Int      @default(0)
  weight                Decimal  @default(0) @db.Decimal(12, 3)
  rolls                 Int      @default(0)
  uomId                 Int?
  processes             String?  @db.Text
  remarks               String?  @db.VarChar(100)
  deleteFlg             Int      @default(0)
  
  header FabricInwardHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  design Design?               @relation(fields: [designId], references: [id])
  fabric Master?               @relation("FabricMaster", fields: [fabricId], references: [id])
  color  Master?               @relation("ColorMaster", fields: [colorId], references: [id])
  dia    Master?               @relation("DiaMaster", fields: [diaId], references: [id])
  uom    Master?               @relation("UOMMaster", fields: [uomId], references: [id])
  
  @@map("fabric_inward_details")
}

model FabricInwardProcess {
  id                    Int      @id @default(autoincrement())
  headerId              Int
  processName           String   @db.VarChar(100)
  rate                  Decimal  @default(0) @db.Decimal(12, 2)
  wetCondition          Int      @default(0)
  productionNotRequired Int      @default(0)
  productionClose       Int      @default(0)
  deleteFlg             Int      @default(0)
  
  header FabricInwardHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  
  @@map("fabric_inward_processes")
}

model RateQuotationHeader {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  quotNo          String   @db.VarChar(10)
  quotDate        DateTime @default(now())
  partyId         Int?
  followupId      Int?
  remarks         String?  @db.VarChar(100)
  paymentTerms    String?  @db.VarChar(20)
  createdBy       String?  @db.VarChar(50)
  createdDate     DateTime @default(now())
  modifiedBy      String?  @db.VarChar(50)
  modifiedDate    DateTime @updatedAt
  deletedBy       String?  @db.VarChar(50)
  deletedDate     DateTime?
  deleteFlg       Int      @default(0)
  yearId          Int?
  concernId       Int?
  sortOrder       Int?
  isApproval      Int      @default(0)
  attachFile      String?  @db.VarChar(100)
  
  tenant  Tenant                   @relation(fields: [tenantId], references: [id])
  concern Concern?                 @relation(fields: [concernId], references: [id])
  party   Party?                   @relation(fields: [partyId], references: [id])
  details RateQuotationDetail[]
  
  @@map("rate_quotation_headers")
}

model RateQuotationDetail {
  id           Int      @id @default(autoincrement())
  headerId     Int
  processId    Int?
  rate         Decimal  @default(0) @db.Decimal(12, 2)
  confirmRate  Decimal  @default(0) @db.Decimal(12, 2)
  remarks      String?  @db.VarChar(100)
  deleteFlg    Int      @default(0)
  
  header  RateQuotationHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  process Process?            @relation(fields: [processId], references: [id])
  
  @@map("rate_quotation_details")
}

model FabricDcHeader {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  dcNo            String   @db.VarChar(10)
  dcDate          DateTime @default(now())
  partyId         Int?
  deliveryTo      Int?
  inwardNo        String?  @db.VarChar(50)
  grnDate         DateTime?
  pdcNo           String?  @db.VarChar(50)
  dyeParty        Int?
  dyeingDcNo      String?  @db.VarChar(50)
  dyeingDcDate    DateTime?
  orderNo         String?  @db.VarChar(100)
  poNo            String?  @db.VarChar(50)
  dcType          String?  @db.VarChar(20)
  fabricType      String?  @db.VarChar(20)
  remarks         String?  @db.VarChar(100)
  vehicleNo       String?  @db.VarChar(20)
  totalQty        Decimal  @default(0) @db.Decimal(12, 3)
  totalRolls      Int      @default(0)
  createdBy       String?  @db.VarChar(50)
  createdDate     DateTime @default(now())
  modifiedBy      String?  @db.VarChar(50)
  modifiedDate    DateTime @updatedAt
  deletedBy       String?  @db.VarChar(50)
  deletedDate     DateTime?
  deleteFlg       Int      @default(0)
  yearId          Int?
  concernId       Int?
  sortOrder       Int?
  hsnCode         String?  @db.VarChar(20)
  isFinal         Int      @default(0)
  isNoNeedBill    Int      @default(0)
  ewayNo          String?  @db.VarChar(50)
  receivedName    String?  @db.VarChar(50)
  
  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  concern   Concern?          @relation(fields: [concernId], references: [id])
  details   FabricDcDetail[]
  processes FabricDcProcess[]
  billDetails FabricBillDetail[]
  
  @@map("fabric_dc_headers")
}

model FabricDcDetail {
  id              Int      @id @default(autoincrement())
  headerId        Int
  inwardDetailId  Int?
  fabricId        Int?
  colorId         Int?
  diaId           Int?
  inwFabricId     Int?
  inwColorId      Int?
  inwDiaId        Int?
  gsm             String?  @db.VarChar(100)
  designNo        String?  @db.VarChar(100)
  designName      String?  @db.VarChar(100)
  noOfColor       Int?
  processWeight   Decimal  @default(0) @db.Decimal(12, 3)
  dcWeight        Decimal  @default(0) @db.Decimal(12, 3)
  weightLoss      Decimal  @default(0) @db.Decimal(12, 3)
  lossPercentage  Decimal  @default(0) @db.Decimal(12, 2)
  rolls           Int      @default(0)
  uomId           Int?
  rate            Decimal  @default(0) @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  processes       String?  @db.Text
  remarks         String?  @db.VarChar(100)
  deleteFlg       Int      @default(0)
  
  header     FabricDcHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  fabric     Master?        @relation("DcFabricMaster", fields: [fabricId], references: [id])
  color      Master?        @relation("DcColorMaster", fields: [colorId], references: [id])
  dia        Master?        @relation("DcDiaMaster", fields: [diaId], references: [id])
  inwFabric  Master?        @relation("DcInwFabricMaster", fields: [inwFabricId], references: [id])
  inwColor   Master?        @relation("DcInwColorMaster", fields: [inwColorId], references: [id])
  inwDia     Master?        @relation("DcInwDiaMaster", fields: [inwDiaId], references: [id])
  uom        Master?        @relation("DcUOMMaster", fields: [uomId], references: [id])
  
  @@map("fabric_dc_details")
}

model FabricDcProcess {
  id          Int      @id @default(autoincrement())
  headerId    Int
  processName String   @db.VarChar(100)
  deleteFlg   Int      @default(0)
  
  header FabricDcHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  
  @@map("fabric_dc_processes")
}

model FabricReturnHeader {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  dcNo            String   @db.VarChar(10)
  dcDate          DateTime @default(now())
  partyId         Int?
  deliveryTo      Int?
  inwardNo        String?  @db.VarChar(50)
  grnDate         DateTime?
  pdcNo           String?  @db.VarChar(50)
  dyeParty        Int?
  dyeingDcNo      String?  @db.VarChar(50)
  dyeingDcDate    DateTime?
  orderNo         String?  @db.VarChar(100)
  poNo            String?  @db.VarChar(50)
  dcType          String?  @db.VarChar(20)
  fabricType      String?  @db.VarChar(20)
  remarks         String?  @db.VarChar(100)
  vehicleNo       String?  @db.VarChar(20)
  totalQty        Decimal  @default(0) @db.Decimal(12, 3)
  totalRolls      Int      @default(0)
  createdBy       String?  @db.VarChar(50)
  createdDate     DateTime @default(now())
  modifiedBy      String?  @db.VarChar(50)
  modifiedDate    DateTime @updatedAt
  deletedBy       String?  @db.VarChar(50)
  deletedDate     DateTime?
  deleteFlg       Int      @default(0)
  yearId          Int?
  concernId       Int?
  sortOrder       Int?
  hsnCode         String?  @db.VarChar(20)
  receivedName    String?  @db.VarChar(50)
  
  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  concern   Concern?              @relation(fields: [concernId], references: [id])
  details   FabricReturnDetail[]
  processes FabricReturnProcess[]
  
  @@map("fabric_return_headers")
}

model FabricReturnDetail {
  id              Int      @id @default(autoincrement())
  headerId        Int
  inwardDetailId  Int?
  fabricId        Int?
  colorId         Int?
  diaId           Int?
  gsm             String?  @db.VarChar(100)
  designNo        String?  @db.VarChar(100)
  designName      String?  @db.VarChar(100)
  noOfColor       Int?
  weight          Decimal  @default(0) @db.Decimal(12, 3)
  rolls           Int      @default(0)
  uomId           Int?
  rate            Decimal  @default(0) @db.Decimal(12, 2)
  amount          Decimal  @default(0) @db.Decimal(12, 2)
  processes       String?  @db.Text
  remarks         String?  @db.VarChar(100)
  deleteFlg       Int      @default(0)
  
  header FabricReturnHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  fabric Master?            @relation("ReturnFabricMaster", fields: [fabricId], references: [id])
  color  Master?            @relation("ReturnColorMaster", fields: [colorId], references: [id])
  dia    Master?            @relation("ReturnDiaMaster", fields: [diaId], references: [id])
  uom    Master?            @relation("ReturnUOMMaster", fields: [uomId], references: [id])
  
  @@map("fabric_return_details")
}

model FabricReturnProcess {
  id          Int      @id @default(autoincrement())
  headerId    Int
  processName String   @db.VarChar(100)
  deleteFlg   Int      @default(0)
  
  header FabricReturnHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  
  @@map("fabric_return_processes")
}

model FabricBillHeader {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  billNo          String   @db.VarChar(10)
  billDate        DateTime @default(now())
  partyId         Int?
  invoiceTo       Int?
  creditDays      Int      @default(0)
  orderNo         String?  @db.VarChar(100)
  remarks         String?  @db.VarChar(100)
  totalQty        Decimal  @default(0) @db.Decimal(12, 3)
  totalRolls      Int      @default(0)
  totalAmount     Decimal  @default(0) @db.Decimal(12, 2)
  noOfDesign      Int      @default(0)
  designRate      Decimal  @default(0) @db.Decimal(12, 2)
  designAmount    Decimal  @default(0) @db.Decimal(12, 2)
  noOfScreen      Int      @default(0)
  screenRate      Decimal  @default(0) @db.Decimal(12, 2)
  screenAmount    Decimal  @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal  @default(0) @db.Decimal(12, 2)
  otherCharges    Decimal  @default(0) @db.Decimal(12, 2)
  roundOff        Decimal  @default(0) @db.Decimal(12, 2)
  recAmount       Decimal  @default(0) @db.Decimal(12, 2)
  diffAmount      Decimal  @default(0) @db.Decimal(12, 2)
  grantAmount     Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @default(0) @db.Decimal(12, 2)
  createdBy       String?  @db.VarChar(50)
  createdDate     DateTime @default(now())
  modifiedBy      String?  @db.VarChar(50)
  modifiedDate    DateTime @updatedAt
  deletedBy       String?  @db.VarChar(50)
  deletedDate     DateTime?
  deleteFlg       Int      @default(0)
  yearId          Int?
  concernId       Int?
  sortOrder       Int?
  hsnCode         String?  @db.VarChar(20)
  ewayNo          String?  @db.VarChar(50)
  ackNo           String?  @db.VarChar(50)
  ackDate         DateTime?
  irnNo           String?  @db.VarChar(100)
  qrText          String?  @db.Text
  isCanceled      Int      @default(0)
  cancelReason    String?  @db.VarChar(100)
  ewbDate         DateTime?
  validDate       DateTime?
  ewbAlert        String?  @db.VarChar(100)
  
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  concern   Concern?            @relation(fields: [concernId], references: [id])
  party     Party?              @relation("BillParty", fields: [partyId], references: [id])
  invoiceParty Party?           @relation("BillInvoiceTo", fields: [invoiceTo], references: [id])
  details   FabricBillDetail[]
  taxes     FabricBillTax[]
  
  @@map("fabric_bill_headers")
}

model FabricBillDetail {
  id          Int      @id @default(autoincrement())
  headerId    Int
  inwardNo    String?  @db.VarChar(100)
  grnId       Int?
  pdcNo       String?  @db.VarChar(50)
  dcNo        String?  @db.VarChar(50)
  dcId        Int?
  dcDate      DateTime?
  fabricId    Int?
  colorId     Int?
  diaId       Int?
  gsm         String?  @db.VarChar(100)
  designNo    String?  @db.VarChar(100)
  designName  String?  @db.VarChar(100)
  noOfColor   Int?
  weight      Decimal  @default(0) @db.Decimal(12, 3)
  rolls       Int      @default(0)
  uomId       Int?
  rate        Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  process     String?  @db.VarChar(100)
  processList String?  @db.Text
  remarks     String?  @db.VarChar(100)
  deleteFlg   Int      @default(0)
  
  header FabricBillHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  fabric Master?          @relation("BillFabricMaster", fields: [fabricId], references: [id])
  color  Master?          @relation("BillColorMaster", fields: [colorId], references: [id])
  dia    Master?          @relation("BillDiaMaster", fields: [diaId], references: [id])
  uom    Master?          @relation("BillUOMMaster", fields: [uomId], references: [id])
  dc     FabricDcHeader?  @relation(fields: [dcId], references: [id])
  
  @@map("fabric_bill_details")
}

model FabricBillTax {
  id            Int     @id @default(autoincrement())
  headerId      Int
  taxName       Int?
  taxPercentage Decimal @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal @default(0) @db.Decimal(12, 2)
  deleteFlg     Int     @default(0)
  
  header     FabricBillHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  taxMaster  Master?          @relation("BillTaxMaster", fields: [taxName], references: [id])
  
  @@map("fabric_bill_taxes")
}

model Settings {
  id                      Int      @id @default(autoincrement())
  tenantId                Int      @unique
  enableItemWiseProcess   Boolean  @default(false)
  defaultHsnCode          String?  @db.VarChar(20)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  tenant Tenant @relation(fields: [tenantId], references: [id])
  
  @@map("settings")
}
